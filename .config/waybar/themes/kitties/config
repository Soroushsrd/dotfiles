{
    // Load Modules
  "include": [
        "~/.config/ml4w/settings/waybar-quicklinks.json",
        "~/.config/waybar/modules.json"
  ],

  "layer": "top",
  "position": "right",
  "width": 28,
  "margin": "2 2 2 2",
  "spacing": 2,
  "modules-left": [
    "custom/appmenu",
    "custom/sep",
    "clock",
    "custom/sep",
    "tray",
    "custom/sep",
    "custom/updates"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "pulseaudio",
    "custom/sep",
    "bluetooth",
    "custom/sep",
    "network",
    "custom/sep",
    "custom/notification",
    "custom/sep",
    "custom/ml4w-welcome",
    "custom/sep",
    "custom/exit",
  ],
  "custom/ml42-welcome":{
    "icon-size": 10,
  },
  "network":{
    "rotate":270
  },
  "bluetooth": {
    "rotate": 270,
  },
  "custom/updates": {
    "rotate": 270
  },

  "custom/appmenu": {
    "rotate": 270,
  },
  "custom/sep": {
    //    "format": "──"
    "format": ""
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "format-icons": {
      "active": "",
      "urgent": "",
      "default": ""
    }
  },
  "clock": {
    "tooltip": true,
    "format": "{:%H\n%M}",
    "tooltip-format": "{:%Y-%m-%d}",
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": true
  },
  "temperature": {
    "rotate": 270,
    "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "pulseaudio": {
    "rotate": 270,
    "format": "{icon}   {volume}%",
    "format-bluetooth": "{icon}   {volume}%",
    "format-muted": "MUTE ",
    "format-icons": {
      "headphones": "",
      "handsfree": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        ""
      ]
    },
    "scroll-step": 3,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
  }
}
