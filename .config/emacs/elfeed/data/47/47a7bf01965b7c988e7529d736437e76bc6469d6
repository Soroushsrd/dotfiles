<span class="giallo-l"><span style="color: #ECEFF4;">         (</span><span style="color: #88C0D0;">let</span><span style="color: #ECEFF4;"> ([</span><span>rest-progn</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">compile</span><span> program</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">+</span><span style="color: #B48EAD;"> 1</span><span> c-ip</span><span style="color: #ECEFF4;">)</span><span> jmp-targets inst-cache</span><span style="color: #ECEFF4;">)])</span></span>
