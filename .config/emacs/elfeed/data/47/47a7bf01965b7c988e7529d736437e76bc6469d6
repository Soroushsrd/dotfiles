<span class="giallo-l"><span style="color: #ECEFF4;">               (</span><span style="color: #81A1C1;">λ</span><span style="color: #ECEFF4;"> (</span><span>state sp</span><span style="color: #ECEFF4;">)</span></span>
<span class="giallo-l"><span style="color: #ECEFF4;">                 (</span><span style="color: #88C0D0;">display</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">integer-&gt;char</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">vector-ref</span><span> state sp</span><span style="color: #ECEFF4;">)))</span></span>
