<span class="giallo-l"><span style="color: #ECEFF4;">  (</span><span style="color: #88C0D0;">if</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">&lt;</span><span> c-ip</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">vector-length</span><span> program</span><span style="color: #ECEFF4;">))</span></span>
<span class="giallo-l"><span style="color: #ECEFF4;">      (</span><span style="color: #88C0D0;">match</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">vector-ref</span><span> program c-ip</span><span style="color: #ECEFF4;">)</span></span>
<span class="giallo-l"><span style="color: #ECEFF4;">        [</span><span style="color: #A3BE8C;">#\+</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">let</span><span style="color: #ECEFF4;"> ([</span><span>rest-progn</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">compile</span><span> program</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">+</span><span style="color: #B48EAD;"> 1</span><span> c-ip</span><span style="color: #ECEFF4;">)</span><span> jmp-targets inst-cache</span><span style="color: #ECEFF4;">)])</span></span>
<span class="giallo-l"><span style="color: #ECEFF4;">               (</span><span style="color: #81A1C1;">λ</span><span style="color: #ECEFF4;"> (</span><span>state sp</span><span style="color: #ECEFF4;">)</span></span>
<span class="giallo-l"><span style="color: #ECEFF4;">                 (</span><span style="color: #88C0D0;">vector-set!</span><span> state sp</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">+</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">vector-ref</span><span> state sp</span><span style="color: #ECEFF4;">)</span><span style="color: #B48EAD;"> 1</span><span style="color: #ECEFF4;">))</span></span>
<span class="giallo-l"><span style="color: #ECEFF4;">                 (</span><span>rest-progn state sp</span><span style="color: #ECEFF4;">)))]</span></span>
