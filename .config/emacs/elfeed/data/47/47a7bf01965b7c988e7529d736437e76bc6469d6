<span class="giallo-l"><span style="color: #ECEFF4;">                 (</span><span>rest-progn state</span><span style="color: #ECEFF4;"> (</span><span style="color: #88C0D0;">+</span><span> sp</span><span style="color: #B48EAD;"> 1</span><span style="color: #ECEFF4;">))))]</span></span>
