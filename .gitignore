# ---- machine state that lives inside stowed config dirs ----
# emacs (see also .config/emacs/.gitignore)
.config/emacs/elfeed/
.config/emacs/elpa/
.config/emacs/auto-save-list/
.config/emacs/.cache/
.config/emacs/eln-cache/
.config/emacs/lisp/escape-dashboard.el
.config/emacs/places.eld
.config/emacs/projects.eld
.config/emacs/recentf.eld
.config/emacs/history
.config/emacs/tramp
.config/emacs/transient/
.config/emacs/tree-sitter/
# ml4w runtime cache (generated wallpaper images etc.)
.config/ml4w/cache/
# shell / tool state
.config/nushell/history.txt
.config/nushell/history.sqlite3*
.config/lazygit/state.yml
.config/waypaper/*.before-*
*.bak
